# ─── App ─────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:8501

# ─── LLM provider (optional) ────────────────────────────────────────
# gemini | openai. openai also covers OpenAI-compatible gateways
# (OpenRouter) via OPENAI_BASE_URL. Leave keys blank for deterministic mode.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
# GEMINI_CHAT_MODEL=gemini-1.5-flash

# ─── Graph checkpointer ─────────────────────────────────────────────
CHECKPOINT_BACKEND=memory          # memory | sqlite (sqlite: see requirements-sqlite.txt)
CHECKPOINT_DB=.careergraph.sqlite

# ─── Observability ─────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-assistant
